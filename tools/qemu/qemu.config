# LibreHU: QEMU test of the AC8257 4.19 kernel (tools/qemu/README.md). Console and disk of the QEMU "virt" machine,
# merged on top of ac8257_ujc201_defconfig by tools/qemu/build_kernel.sh. Not for the unit.
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
