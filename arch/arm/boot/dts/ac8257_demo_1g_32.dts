&pio {
	txd0: utxd0 {
			pins_cmd_dat {
			pinmux = <PINMUX_GPIO96__FUNC_UTXD0>;
			};
	};
	rxd0: urxd0{
			pins_cmd_dat {
			pinmux = <PINMUX_GPIO95__FUNC_URXD0>;
			};
	};
	tx0_gpio: utx_gpio0 {
			pins_cmd_dat {
			pinmux = <PINMUX_GPIO96__FUNC_GPIO96>;
			};
	};
	rx0_gpio: urx_gpio0{
			pins_cmd_dat {
			pinmux = <PINMUX_GPIO95__FUNC_GPIO95>;
			};
	};
	txd1: utxd1 {
			pins_cmd_dat {
			pinmux = <PINMUX_GPIO107__FUNC_UTXD1>;
			};
	};
	rxd1: urxd1{
			pins_cmd_dat {
			pinmux = <PINMUX_GPIO109__FUNC_URXD1>;
			};
	};
	tx1_gpio: utx_gpio1 {
			pins_cmd_dat {
			pinmux = <PINMUX_GPIO107__FUNC_GPIO107>;
			};
	};
	rx1_gpio: urx_gpio1{
			pins_cmd_dat {
			pinmux = <PINMUX_GPIO109__FUNC_GPIO109>;
			};
	};
	txd2: utxd2 {
			pins_cmd_dat {
			pinmux = <PINMUX_GPIO180__FUNC_UTXD2>;
			};
	};
	rxd2: urxd2{
			pins_cmd_dat {
			pinmux = <PINMUX_GPIO179__FUNC_URXD2>;
			};
	};
	tx2_gpio: utx_gpio2 {
			pins_cmd_dat {
			pinmux = <PINMUX_GPIO180__FUNC_GPIO180>;
			};
	};
	rx2_gpio: urx_gpio2 {
			pins_cmd_dat {
			pinmux = <PINMUX_GPIO179__FUNC_GPIO179>;
			};
	};
	txd3: utxd3 {
			pins_cmd_dat {
			pinmux = <PINMUX_GPIO182__FUNC_UTXD3>;
			};
	};
	rxd3: urxd3{
			pins_cmd_dat {
			pinmux = <PINMUX_GPIO181__FUNC_URXD3>;
			};
	};
	tx3_gpio: utx_gpio3 {
			pins_cmd_dat {
			pinmux = <PINMUX_GPIO182__FUNC_GPIO182>;
			};
	};
	rx3_gpio: urx_gpio3 {
			pins_cmd_dat {
			pinmux = <PINMUX_GPIO181__FUNC_GPIO181>;
			};
	};
};

