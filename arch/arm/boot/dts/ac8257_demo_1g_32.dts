&i2c0 {
	cap_touch_mtk:cap_touch@5d {
		  compatible = "mediatek,cap_touch";
		  reg = <0x5d>;

		  ti-link = <0x0>;
		  ti-serializer = <0x1a>;  /* <0x1a>; */
		  ti-deserializer = <0x2C>;  /* <0x2C>; */

		  status = "okay";
	};

	lcm_bridge_ic@c {
		compatible = "autochips,lcm_bridge_ic";
		reg = <0x0c>;
		lcm_id = <0>;
		status = "okay";
        };
};

&i2c1 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <100000>;
	multiplexing = <1>; /* multiplexing by arm2 */

	lcm_bridge_ic@c {
		compatible = "autochips,lcm_bridge_ic";
		reg = <0x0c>;
		lcm_id = <1>;
		status = "okay";
	};

	/* 720P demo board */
	ctp_cust@03 {
		compatible = "Autochips,customize";
		pinctrl-names = "sda", "scl", "int", "rst";
		pinctrl-0 = <&ctpB_pins_sda>;
		pinctrl-1 = <&ctpB_pins_scl>;
		pinctrl-2 = <&ctpB_pins_int>;
		pinctrl-3 = <&ctpB_pins_rst>;

		reg = <0x1A>;
		touchscreen-abs-x-max = <1920>;
		touchscreen-abs-y-max = <720>;

		serializer-addr = <0x0E>;
		deserializer-addr = <0x2C>;

		touchpad-addr = <0x1A>;

		touchscreen-extern = <0>;

		reset-gpios = <&pio 178 0>;
		irq-gpios = <&pio 12 0>;

		irq_mode = <0x1>;

		interrupt-parent = <&pio>;
		interrupts = <12 IRQ_TYPE_EDGE_FALLING 12 0>;

		status = "okay";
	};

	/* 720P Main  */
	ctp@04 {
		compatible = "goodix,gt928";
		pinctrl-names = "sda", "scl", "int", "rst";
		pinctrl-0 = <&ctpA_pins_sda>;
		pinctrl-1 = <&ctpA_pins_scl>;
		pinctrl-2 = <&ctpB_pins_int>;
		pinctrl-3 = <&ctpB_pins_rst>;

		reg = <0x2>;
		reset-gpios = <&pio 178 0>;
		irq-gpios = <&pio 12 0>;

		irq_mode = <0x1>;
		slave_addr = <0x14>;

		interrupt-parent = <&pio>;
		interrupts = <12 IRQ_TYPE_EDGE_FALLING 12 0>;

		/* abs-x-max abs-y-max swapped-x-y inverted-x inverted-y */
		tps-info = <1024 600 0 0 0
			720 1920 1 0 0
			0 0 0 0 0 >;
		touchscreen-supported = <2>;

		touchscreen-extern = <0>;

		ti-link = <0x4>;
		ti-serializer = <0x1a>;  /* <0x1a>; */
		ti-deserializer = <0x2c>;  /* <0x2C>; */
		status = "disabled";
	};

	/* 720P Main Core board */
	ctp_cust_core@03 {
		compatible = "Autochips,customize";
		pinctrl-names = "sda", "scl", "int", "rst";
		pinctrl-0 = <&ctp0A_pins_sda>;
		pinctrl-1 = <&ctp0A_pins_scl>;
		pinctrl-2 = <&ctp_core_pins_int>;
		pinctrl-3 = <&ctp_core_pins_rst>;

		reg = <0x1A>;
		touchscreen-abs-x-max = <1920>;
		touchscreen-abs-y-max = <720>;

		serializer-addr = <0x0E>;
		deserializer-addr = <0x2D>;

		touchpad-addr = <0x1A>;

		touchscreen-extern = <0>;

		reset-gpios = <&pio 4 0>;
		irq-gpios = <&pio 5 0>;

		irq_mode = <0x1>;

		interrupt-parent = <&pio>;
		interrupts = <5 IRQ_TYPE_EDGE_FALLING 5 0>;

		status = "disabled";
	};
};

