&pio {
/* USB GPIO start */
	gpio42_mode0_drvvbus: drvvbus_init {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO42__FUNC_GPIO42>;
			slew-rate = <1>;
			output-low;
		};
	};

	gpio42_mode0_drvvbus_low: drvvbus_low {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO42__FUNC_GPIO42>;
			slew-rate = <1>;
			output-low;
		};
	};

	gpio42_mode0_drvvbus_high: drvvbus_high {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO42__FUNC_GPIO42>;
			slew-rate = <1>;
			output-high;
		};
	};
};


&usb0 {
	pinctrl-names = "drvvbus_init", "drvvbus_low", "drvvbus_high";
	pinctrl-0 = <&gpio42_mode0_drvvbus>;
	pinctrl-1 = <&gpio42_mode0_drvvbus_low>;
	pinctrl-2 = <&gpio42_mode0_drvvbus_high>;
	status = "okay";
};

#include <ac8257_demo_1g_32/cust.dtsi>


&pio {
	ctpA_pins_int: tpAeint@0 {
				   pins_cmd_dat {
					   pinmux = <PINMUX_GPIO0__FUNC_GPIO0>;
					   slew-rate = <0>;
					   bias-pull-up;
				   };
			   };

	ctpA_pins_rst: tpArstoutput0 {
					   pins_cmd_dat {
						   pinmux = <PINMUX_GPIO174__FUNC_GPIO174>;
						   slew-rate = <1>;
					   };
				   };
	ctpA_pins_sda: tpA_sda {
					   pins_cmd_dat {
						   pinmux = <PINMUX_GPIO81__FUNC_SDA1>;
						   slew-rate = <1>;
						   drive-strength = <7>;
					   };
				   };
	ctpA_pins_scl: tpA_scl {
					   pins_cmd_dat {
						   pinmux = <PINMUX_GPIO84__FUNC_SCL1>;
						   slew-rate = <1>;
						   drive-strength = <7>;
					   };
				   };

	ctpB_pins_int: tpBeint@0 {
					   pins_cmd_dat {
						   pinmux = <PINMUX_GPIO12__FUNC_GPIO12>;
						   slew-rate = <0>;
						   bias-pull-up;
					   };
				   };

	ctpB_pins_rst: tpBrstoutput0 {
					   pins_cmd_dat {
						   pinmux = <PINMUX_GPIO178__FUNC_GPIO178>;
						   slew-rate = <1>;
					   };
				   };
	ctpB_pins_sda: tpB_sda {
					   pins_cmd_dat {
						   pinmux = <PINMUX_GPIO81__FUNC_SDA1>;
						   slew-rate = <1>;
						   drive-strength = <7>;
					   };
				   };
	ctpB_pins_scl: tpB_scl {
					   pins_cmd_dat {
						   pinmux = <PINMUX_GPIO84__FUNC_SCL1>;
						   slew-rate = <1>;
						   drive-strength = <7>;
					   };
				   };

	ctp_core_pins_int: tpcoreeint@0 {
					   pins_cmd_dat {
						   pinmux = <PINMUX_GPIO5__FUNC_GPIO5>;
						   slew-rate = <0>;
						   bias-pull-up;
					   };
				   };

	ctp_core_pins_rst: tpcorerstoutput0 {
					   pins_cmd_dat {
						   pinmux = <PINMUX_GPIO4__FUNC_GPIO4>;
						   slew-rate = <1>;
					   };
				   };
};


&pio {
	ctp0A_pins_sda: tp0A_sda {
