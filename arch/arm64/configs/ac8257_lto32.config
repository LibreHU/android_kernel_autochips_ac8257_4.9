# LibreHU: kernel for a 32 MiB boot partition (TWRP zip librehu_boot32_twrp.zip), merged after ac8257_a9.config or
# ac8257_a10.config. The 10 MiB boot partition of the stock layout cannot hold it.
# - ThinLTO (clang + ld.lld): the image grows by about 470 KiB (.rela.dyn without PREL32 relocations), the code is
#   optimised across files. Needs LD=ld.lld (LD_IS_LLD), AR=llvm-ar and NM=llvm-nm on the make command line.
# - Everything built in, no loadable module to install: WMT, Wi-Fi, Bluetooth, GPS and FM radio in the kernel
#   (kernel/module.c refuses the stock and LibreHU connectivity modules the vendor init scripts still load), and the
#   three drivers left as modules in the defconfig.
CONFIG_LTO_CLANG=y
CONFIG_THINLTO=y
# CONFIG_LIBREHU_CONN_MODULES is not set
CONFIG_MTK_COMBO_DRV_BUILD_IN=y
CONFIG_TCP_CONG_WESTWOOD=y
CONFIG_TCP_CONG_HTCP=y
CONFIG_USB_GSPCA=y
