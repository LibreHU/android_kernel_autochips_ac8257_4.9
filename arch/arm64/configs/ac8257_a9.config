# LibreHU: Android 9 build of the AC8257 4.19 kernel (LineageOS 16.0, stock ROM)
# Android 9 enables bandwidth control only with /proc/net/xt_qtaguid/ctrl (else NetworkPolicy waits 30 s at boot);
# xt_qtaguid provides the "owner" match itself, so xt_owner is off, as in the 4.9 kernel.
CONFIG_LOCALVERSION="-a9"
# CONFIG_NETFILTER_XT_MATCH_OWNER is not set
CONFIG_NETFILTER_XT_MATCH_QTAGUID=y
# Legacy VPNs of the Settings app on Android 9: mtpd opens PX_PROTO_OLAC (L2TP/IPsec) and PX_PROTO_OPNS (PPTP),
# the Android pppolac / pppopns drivers of the 4.9 kernel (Android 10 uses the upstream L2TP / PPTP, see a10)
CONFIG_PPPOLAC=y
CONFIG_PPPOPNS=y
