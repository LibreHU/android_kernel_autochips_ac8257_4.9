# LibreHU: Android 10 and later build of the AC8257 4.19 kernel (LineageOS 17.1...): traffic accounting by eBPF,
# no xt_qtaguid (as the Android common kernels), xt_owner on
CONFIG_LOCALVERSION="-a10"
CONFIG_NETFILTER_XT_MATCH_OWNER=y
# CONFIG_NETFILTER_XT_MATCH_QTAGUID is not set
# Options of the Android 10 kernel requirements (kernel/configs q/android-4.19/android-base.config) missing from the
# defconfig: legacy VPNs of the Settings app (mtpd of Android 10 opens PX_PROTO_OL2TP / PX_PROTO_PPTP), eBPF tc
# classifier (464xlat clat of netd), GRE demultiplexer (PPTP), XFRM interfaces and statistics (IpSecService)
CONFIG_L2TP=y
CONFIG_PPPOL2TP=y
CONFIG_NET_IPGRE_DEMUX=y
CONFIG_PPTP=y
CONFIG_NET_CLS_BPF=y
CONFIG_XFRM_INTERFACE=y
CONFIG_XFRM_STATISTICS=y
